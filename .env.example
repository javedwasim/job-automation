# --- App ---
APP_ENV=local
DEBUG=true
SECRET_KEY=change-me

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root_change_me
MYSQL_DATABASE=job_automation
MYSQL_USER=job_automation
MYSQL_PASSWORD=job_automation
DATABASE_URL=mysql+pymysql://job_automation:job_automation@mysql:3306/job_automation

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Gmail ingestion (spec section 20) ---
JOB_ALERT_LOOKBACK_HOURS=24
JOB_ALERT_POLL_INTERVAL=5
JOB_AUTOMATION_PROCESSED_LABEL=JOB_AUTOMATION_PROCESSED

# --- Gmail OAuth (Phase 1) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback

# --- Classification ---
JOB_CLASSIFIER=rules

# --- Redirect resolution (Phase 3) ---
REDIRECT_MAX_HOPS=5
REDIRECT_TIMEOUT_SECONDS=5.0

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
